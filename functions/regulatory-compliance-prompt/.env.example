# Environment Variables for Regulatory Compliance Prompt Function
# Copy this file to .env and fill in your actual values for local testing

# System Prompts Configuration
SYSTEM_PROMPTS_TABLE_NAME=system-prompts

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# S3 Buckets - Document Load
S3_DOCUMENTS_BUCKET_NAME=supervisory-records
S3_CSV_BUCKET_NAME=supervisory-records-csv-analysis

# S3 Buckets - Letter Analysis
S3_LETTER_REPORTS_BUCKET_NAME=warranty-analysis-reports

# S3 Buckets - Warranty Analysis
S3_WARRANTY_REPORTS_BUCKET_NAME=warranty-analysis-reports

# DynamoDB Tables - Analysis
LETTER_ANALYSIS_TABLE_NAME=letter-analysis
WARRANTY_ANALYSIS_TABLE_NAME=preferred-warranty-analysis

# Feature Flags
SAVE_CSV_FLAG=false

# AWS Region (optional, defaults to your AWS CLI configuration)
AWS_REGION=us-east-1

# AWS Profile (use your configured AWS CLI profile)
AWS_PROFILE=protecso-dev

# AWS Credentials (optional, uses AWS CLI credentials by default)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Local Server Port (for npm run local:server)
PORT=3001
